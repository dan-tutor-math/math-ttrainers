      "css": ".ds-example{--ds-bg:var(--bg,#EEF1F7);--ds-pencil:var(--pencil,#202534);--ds-ink:var(--ink,#004C99);--ds-paper:var(--paper,#fff);--ds-muted:var(--muted,#5d6576);--ds-glass-strong:var(--glass-strong,rgba(255,255,255,.76));--ds-glass-border:var(--glass-border,rgba(255,255,255,.9));--ds-shadow:var(--shadow,0 8px 26px rgba(34,52,80,.07));--ds-line:var(--line,#d9dfe9);--ds-stage:var(--stage,#e4eaf2);--ds-font-ui:var(--font-ui,'Onest',system-ui,sans-serif);font:15px/1.55 var(--ds-font-ui);color:var(--ds-pencil);color-scheme:light}.ds-example[data-theme=dark]{--ds-bg:var(--bg,#0B0E1A);--ds-pencil:var(--pencil,#F2F3F5);--ds-ink:var(--ink,#78a8ef);--ds-paper:var(--paper,#181f31);--ds-muted:var(--muted,#b6bfd1);--ds-glass-strong:var(--glass-strong,rgba(34,43,65,.8));--ds-glass-border:var(--glass-border,rgba(255,255,255,.13));--ds-shadow:var(--shadow,0 8px 30px rgba(0,0,0,.2));--ds-line:var(--line,#344158);--ds-stage:var(--stage,#141d2e);color-scheme:dark}.ds-button{font:inherit;border:1px solid var(--ds-line);border-radius:11px;padding:9px 13px;background:var(--ds-paper);color:var(--ds-pencil);cursor:pointer;min-height:42px}.ds-button:disabled{opacity:.4;cursor:default}.ds-button:focus-visible{outline:3px solid var(--ds-ink);outline-offset:3px}.ds-button[aria-pressed=true]{background:var(--ds-ink);color:var(--ds-paper);border-color:var(--ds-ink)}@media(hover:hover){.ds-button:not(:disabled):hover{filter:brightness(.97)}.ds-example[data-theme=dark] .ds-button:not(:disabled):hover{filter:brightness(1.15)}}.ds-button.ds-pill{text-align:left;display:flex;align-items:baseline;gap:10px;border:0;border-radius:12px;padding:10px 12px;background:var(--tint,var(--ds-paper));font-size:12px;line-height:1.5}.ds-button.ds-pill b{font-size:17px;min-width:30px;color:var(--dimension)}.ds-button.ds-pill.ds-active{box-shadow:inset 0 0 0 1.5px var(--dimension)}"
    },
    {
      "name": "Ползунок ширины",
      "kind": "input",
      "refersTo": "width-slider",
      "description": "Подпись и текущее значение в миллиметрах над дорожкой.",
      "html": "<div class=\"ds-example\"><label class=\"ds-slider\" style=\"--dimension:#2A5DBF\"><span>B · Ширина</span><output>195 мм</output><input type=\"range\" min=\"125\" max=\"355\" step=\"5\" value=\"195\"></label></div>",
      "css": ".ds-example{--ds-bg:var(--bg,#EEF1F7);--ds-pencil:var(--pencil,#202534);--ds-ink:var(--ink,#004C99);--ds-paper:var(--paper,#fff);--ds-muted:var(--muted,#5d6576);--ds-glass-strong:var(--glass-strong,rgba(255,255,255,.76));--ds-glass-border:var(--glass-border,rgba(255,255,255,.9));--ds-shadow:var(--shadow,0 8px 26px rgba(34,52,80,.07));--ds-line:var(--line,#d9dfe9);--ds-stage:var(--stage,#e4eaf2);--ds-font-ui:var(--font-ui,'Onest',system-ui,sans-serif);font:15px/1.55 var(--ds-font-ui);color:var(--ds-pencil);color-scheme:light}.ds-example[data-theme=dark]{--ds-bg:var(--bg,#0B0E1A);--ds-pencil:var(--pencil,#F2F3F5);--ds-ink:var(--ink,#78a8ef);--ds-paper:var(--paper,#181f31);--ds-muted:var(--muted,#b6bfd1);--ds-glass-strong:var(--glass-strong,rgba(34,43,65,.8));--ds-glass-border:var(--glass-border,rgba(255,255,255,.13));--ds-shadow:var(--shadow,0 8px 30px rgba(0,0,0,.2));--ds-line:var(--line,#344158);--ds-stage:var(--stage,#141d2e);color-scheme:dark}.ds-slider{display:grid;grid-template-columns:1fr auto;gap:4px;font-size:12px;margin-bottom:12px}.ds-slider output{font-weight:650;font-variant-numeric:tabular-nums}.ds-slider input{grid-column:1/-1;width:100%;margin:3px 0;accent-color:var(--dimension);height:24px}.ds-slider input:focus-visible{outline:3px solid var(--ds-ink);outline-offset:3px}"
