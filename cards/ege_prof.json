   "table": null,
   "opts": null,
   "answer": {
    "kind": "fields",
    "fields": [
     {
      "id": "main",
      "label": "Ответ:",
      "type": "plain",
      "value": "0,9",
      "alts": [],
      "seq": false,
      "anyOrder": false,
      "unit": ""
     }
    ],
    "value": "0,9"
   },
   "solution": "<div class=\"c-line\">По теореме Пифагора: $$AC = \\sqrt{10^2 - 19} = 9$$</div><div class=\"c-line\">$$\\cos A = \\dfrac{AC}{AB} = \\dfrac{9}{10} = 0{,}9$$</div>",
   "source": "Открытый банк заданий ФИПИ, задание A33A46"
  },
