   "table": null,
   "opts": null,
   "answer": {
    "kind": "fields",
    "fields": [
     {
      "id": "main",
      "label": "Ответ:",
      "type": "plain",
      "value": "3",
      "alts": [],
      "seq": false,
      "anyOrder": false,
      "unit": ""
     }
    ],
    "value": "3"
   },
   "solution": "<div class=\"c-line\">По теореме синусов $\\dfrac{AB}{\\sin C} = 2R$:</div><div class=\"c-line\">$$R = \\dfrac{3 \\sqrt{2}}{2\\sin 135^\\circ} = \\dfrac{3 \\sqrt{2}}{2 \\cdot \\frac{\\sqrt{2}}{2}} = 3$$</div>",
   "source": "Открытый банк заданий ФИПИ, задание 1DD37A"
  },
